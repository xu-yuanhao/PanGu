  "build": "python3 -B tools/runtime/build_test.py",
  "product_runtime_dependencies": "Core uses C ABI layouts, not a required C implementation; optional hosted transport/tool adapters use registered libcurl/json-c/libc/POSIX.",
  "limits": {
    "messages": 64,
    "text_bytes_including_terminator": 4096,
    "id_bytes_including_terminator": 64,
    "model_turns_per_run": 16,
    "registered_tools": 16
  },
  "deferred": [
    "stable plugin ABI",
    "full Pi content blocks",
    "multiple tool calls per turn",
    "asynchronous side-effect tools",
    "persistent session",
    "full G01/G02 certification"
  ],
  "local_provider_dependencies": [
    {
      "name": "libcurl",
      "version": "8.23.0",
      "source": "system pkg-config libcurl",
      "license": "curl license",
      "purpose": "HTTPS/TLS and cancellable multi transport",
      "impact": "hosted provider only; transitive TLS/compression/system libraries resolved by system libcurl, not part of dependency-free loop; packaging/size and other platforms not certified"
    },
    {
      "name": "json-c",
      "version": "0.19",
      "source": "system pkg-config json-c",
      "license": "MIT",
      "purpose": "bounded-response JSON conversion in first live adapter",
      "impact": "hosted provider only; own native JSON integration deferred; heap allocations in adapter, not loop"
    }
  ],
  "real_model_validation": "real SSE tool/read roundtrips, multi-run context recall/reset, cancel followed by new input verified",
  "interactive_build": "python3 -B tools/runtime/build_pangu.py --output /tmp/pangu-native/pangu",
  "interactive_validation": "PTY offline restoration and real MiMo tool/cancellation checks; tests/runtime and tests/client/tui are test inputs only",
  "implementation_priority": [
    "assembly",
    "c",
    "cpp"
  ],
  "reference_basis_scope": "Source locators only; read corresponding functions/callers/tests before each implementation batch, record decisions in existing progress/handoff; not proof of reading or compatibility; references never enter product build. Primary behavioral target is Pi Durable; historical Pi agent references are secondary and historical snapshots remain unchanged."
}
