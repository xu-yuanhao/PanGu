# Replaces repeated manual install/find_package/link/run validation.
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command ${ARGV} failed (${result})\n${output}\n${errors}")
  endif()
endfunction()
if(NOT DEFINED fixture_name)
  set(fixture_name installed-consumer)
endif()
if(NOT DEFINED consumer_source)
  set(consumer_source "${source}/tests/core/installed-consumer")
endif()
if(NOT DEFINED install_component)
  set(install_component Core)
endif()
set(prefix "${binary}/${fixture_name}/prefix")
set(consumer_build "${binary}/${fixture_name}/build")
# This dedicated fixture path is owned entirely by this test.
file(REMOVE_RECURSE "${binary}/${fixture_name}")
set(config_args)
set(ctest_args)
if(NOT "${config}" STREQUAL "")
  list(APPEND config_args --config "${config}")
  list(APPEND ctest_args -C "${config}")
endif()
set(component_args)
if(NOT "${install_component}" STREQUAL "")
  list(APPEND component_args --component "${install_component}")
endif()
run("${CMAKE_COMMAND}" --install "${binary}" --prefix "${prefix}" ${config_args} ${component_args})
if(require_service_notices)
  foreach(notice curl-LICENSE libuv-LICENSE valijson-LICENSE picojson-LICENSE)
    if(NOT EXISTS "${prefix}/share/licenses/PanGu/${notice}")
      message(FATAL_ERROR "Installed service dependency notice missing: ${notice}")
    endif()
  endforeach()
  file(GLOB_RECURSE resource_exports "${prefix}/*/cmake/PanGuServices/PanGuServicesTargets.cmake")
  foreach(export IN LISTS resource_exports)
    file(READ "${export}" exported_targets)
    if(exported_targets MATCHES "PanGu::services_resources")
      foreach(notice libyaml-LICENSE libgit2-COPYING)
        if(NOT EXISTS "${prefix}/share/licenses/PanGu/${notice}")
          message(FATAL_ERROR "Installed resource dependency notice missing: ${notice}")
        endif()
      endforeach()
    endif()
  endforeach()
endif()
if(require_overflow_notices)
  foreach(notice BSD-3-Clause.txt BSD-2-Clause.txt PCRE2-exception.txt)
    if(NOT EXISTS "${prefix}/share/licenses/PanGu/pcre2/${notice}")
      message(FATAL_ERROR "Installed classifier notice missing: ${notice}")
    endif()
  endforeach()
endif()
if(require_agent_notices)
  foreach(notice sqlite-LICENSE libuv-LICENSE utf8proc-LICENSE.md)
    if(NOT EXISTS "${prefix}/share/licenses/PanGu/${notice}")
      message(FATAL_ERROR "Installed agent dependency notice missing: ${notice}")
    endif()
  endforeach()
endif()
run("${CMAKE_COMMAND}" -S "${consumer_source}" -B "${consumer_build}"
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_C_COMPILER=${compiler}"
    "-DCMAKE_C_FLAGS=${flags}" "-DCMAKE_BUILD_TYPE=${config}"
    "-DPANGU_CONSUMER_PRESENTATION=${require_presentation}")
run("${CMAKE_COMMAND}" --build "${consumer_build}" ${config_args})
run("${ctest}" --test-dir "${consumer_build}" ${ctest_args} --output-on-failure)
