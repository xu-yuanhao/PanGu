file(REMOVE "${session}")
set(agent_directory "${session}-config")
file(MAKE_DIRECTORY "${agent_directory}")
foreach(backend jsonl sqlite)
  set(native_session "${session}-native-${backend}")
  file(REMOVE "${native_session}")
  set(storage)
  if(backend STREQUAL "sqlite")
    set(storage --sqlite)
  endif()
  execute_process(COMMAND "${cli}" create "${native_session}" ${storage} --agent-dir "${agent_directory}" --no-tools --plugin "${plugin}" --deepseek "installed native prompt" RESULT_VARIABLE result OUTPUT_VARIABLE created ERROR_VARIABLE errors)
  if(NOT result EQUAL 0 OR NOT created MATCHES "assistant: installed native reply")
    message(FATAL_ERROR "Installed native CLI failed: ${result} ${created} ${errors}")
  endif()
  execute_process(COMMAND "${cli}" open "${native_session}" ${storage} --agent-dir "${agent_directory}" RESULT_VARIABLE result OUTPUT_VARIABLE reopened ERROR_VARIABLE errors)
  if(NOT result EQUAL 0 OR NOT reopened STREQUAL created)
    message(FATAL_ERROR "Installed native CLI reopen differs: ${result} ${reopened} ${errors}")
  endif()
  file(REMOVE "${native_session}")
  if(DEFINED python)
    set(mcp_config "${native_session}-mcp.json")
    string(JSON server SET "{}" command "\"${python}\"")
    string(JSON arguments SET "[]" 0 "\"${peer}\"")
    string(JSON server SET "${server}" args "${arguments}")
    string(JSON servers SET "{}" sdk "${server}")
    string(JSON configuration SET "{}" mcpServers "${servers}")
    file(WRITE "${mcp_config}" "${configuration}")
    execute_process(COMMAND "${cli}" create "${native_session}" ${storage} --agent-dir "${agent_directory}" --no-tools --plugin "${plugin}" --mcp-config "${mcp_config}" --deepseek "installed MCP prompt" RESULT_VARIABLE result OUTPUT_VARIABLE created ERROR_VARIABLE errors)
    if(NOT result EQUAL 0 OR NOT created MATCHES "installed MCP reply" OR NOT created MATCHES "assistant: installed native reply")
      message(FATAL_ERROR "Installed MCP CLI failed: ${result} ${created} ${errors}")
    endif()
    execute_process(COMMAND "${cli}" open "${native_session}" ${storage} --agent-dir "${agent_directory}" RESULT_VARIABLE result OUTPUT_VARIABLE reopened ERROR_VARIABLE errors)
    if(NOT result EQUAL 0 OR NOT reopened STREQUAL created)
      message(FATAL_ERROR "Installed MCP CLI reopen differs: ${result} ${reopened} ${errors}")
    endif()
    foreach(policy ask never)
      set(approval_session "${native_session}-approval-${policy}")
      if(policy STREQUAL "ask")
        set(expected_decision "Tool approval unavailable")
      else()
        set(expected_decision "Tool approval rejected")
      endif()
      execute_process(COMMAND "${cli}" create "${approval_session}" ${storage} --agent-dir "${agent_directory}" --no-tools --plugin "${plugin}" --mcp-config "${mcp_config}" --approval ${policy} --deepseek "installed guarded MCP prompt" RESULT_VARIABLE result OUTPUT_VARIABLE created ERROR_VARIABLE errors)
      if(NOT result EQUAL 0 OR NOT created MATCHES "${expected_decision}" OR created MATCHES "installed MCP reply" OR NOT created MATCHES "assistant: installed native reply")
        message(FATAL_ERROR "Installed guarded MCP CLI failed (${policy}): ${result} ${created} ${errors}")
      endif()
      execute_process(COMMAND "${cli}" open "${approval_session}" ${storage} --agent-dir "${agent_directory}" RESULT_VARIABLE result OUTPUT_VARIABLE reopened ERROR_VARIABLE errors)
      if(NOT result EQUAL 0 OR NOT reopened STREQUAL created)
        message(FATAL_ERROR "Installed guarded MCP CLI reopen differs (${policy}): ${result} ${reopened} ${errors}")
      endif()
      file(REMOVE "${approval_session}")
    endforeach()
    file(REMOVE "${native_session}" "${mcp_config}")
  endif()
endforeach()
execute_process(COMMAND "${cli}" create "${session}" --agent-dir "${agent_directory}" --demo "installed CLI" RESULT_VARIABLE result OUTPUT_VARIABLE created ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT created MATCHES "assistant: PanGu deterministic demo response")
  message(FATAL_ERROR "Installed CLI run failed: ${result} ${created} ${errors}")
endif()
execute_process(COMMAND "${cli}" open "${session}" --agent-dir "${agent_directory}" RESULT_VARIABLE result OUTPUT_VARIABLE reopened ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT reopened STREQUAL created)
  message(FATAL_ERROR "Installed CLI reopen differs: ${result} ${reopened} ${errors}")
endif()
file(REMOVE "${session}")
