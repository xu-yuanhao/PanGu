file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/agent-cli.jsonl")
execute_process(COMMAND "${cli}" create "${CMAKE_CURRENT_BINARY_DIR}/agent-cli.jsonl" --demo "save me" RESULT_VARIABLE rc OUTPUT_VARIABLE created)
if(NOT rc EQUAL 0 OR NOT created MATCHES "assistant: PanGu deterministic demo response")
 message(FATAL_ERROR "CLI create/run failed: ${rc} ${created}")
endif()
execute_process(COMMAND "${cli}" open "${CMAKE_CURRENT_BINARY_DIR}/agent-cli.jsonl" RESULT_VARIABLE rc OUTPUT_VARIABLE reopened)
if(NOT rc EQUAL 0 OR NOT reopened STREQUAL created)
 message(FATAL_ERROR "CLI reopen differs: ${rc} ${reopened}")
endif()
file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/agent-cli.jsonl")
