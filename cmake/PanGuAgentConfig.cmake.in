@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PanGuCore CONFIG)
find_dependency(PanGuServices CONFIG)
if(@PANGU_CONFIG_AGENT_OVERFLOW@)
  find_dependency(PanGuOverflow CONFIG)
endif()
find_dependency(SQLite3)
if(NOT TARGET SQLite3::SQLite3)
  add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
endif()
find_dependency(PkgConfig)
pkg_check_modules(PG_AGENT_UV REQUIRED IMPORTED_TARGET libuv>=1.44)
pkg_check_modules(PG_AGENT_UTF8PROC REQUIRED IMPORTED_TARGET libutf8proc)
include("${CMAKE_CURRENT_LIST_DIR}/PanGuAgentTargets.cmake")
check_required_components(PanGuAgent)
