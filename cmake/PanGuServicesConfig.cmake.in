@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PanGuCore CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(PANGU_UV REQUIRED IMPORTED_TARGET libuv>=1.44)
find_dependency(CURL 7.85)
if(@PANGU_SERVICES_IMAGES@)
  pkg_check_modules(PANGU_PIXBUF REQUIRED IMPORTED_TARGET gdk-pixbuf-2.0>=2.42)
endif()
if(@PANGU_CONFIG_RESOURCES@)
  pkg_check_modules(PANGU_YAML REQUIRED IMPORTED_TARGET yaml-0.1>=0.2.5)
  pkg_check_modules(PANGU_GIT2 REQUIRED IMPORTED_TARGET libgit2>=1.8)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PanGuServicesTargets.cmake")
check_required_components(PanGuServices)
