@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PanGuCore CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(TUI_UTF8PROC REQUIRED IMPORTED_TARGET libutf8proc)
pkg_check_modules(TUI_UV REQUIRED IMPORTED_TARGET libuv>=1.44)
if(NOT MSVC)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PanGuTUITargets.cmake")
check_required_components(PanGuTUI)
